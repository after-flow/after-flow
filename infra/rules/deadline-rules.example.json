  "initialProcedures": [
    {
      "id": "death-notification",
      "title": "死亡届を提出する",
      "summary": "死亡届の用紙は、病院などで受け取る死亡診断書（死体検案書）と1枚になっています。左側の死亡届に記入し、市区町村の窓口へ出します。火葬許可の申請も同時に行い、火葬許可証を受け取ります（許可証がないと火葬できません）。葬儀社が代わりに出すことも多いので、済んでいるか確かめてください。国外で亡くなった場合は3か月以内です。",
      "stage": "immediate",
      "category": "役所手続き",
      "submitTo": "故人の本籍地・亡くなった場所、または届出人の住所地の市区町村役場（戸籍の窓口）",
      "evidenceRequired": false,
      "assetDisposal": false,
      "requiredDocuments": [
        {
          "id": "death-certificate",
          "label": "死亡診断書（原本）"
        },
        {
          "id": "applicant-identification",
          "label": "届出人の本人確認書類"
        }
      ],
      "deadlineRuleId": "death-notification",
      "applicability": {
        "default": "yes",
        "rules": []
      },
      "variants": [],
      "targetDate": null
    },
    {
      "id": "household-change",
      "title": "世帯主変更届を出す",
      "summary": "故人が世帯主で、同じ世帯に残る方が2人以上いる場合に必要です。残る方が1人のときや、残るのが親1人とその15歳未満の子だけのときなど、次の世帯主が明らかな場合は不要です。",
      "stage": "government",
      "category": "役所手続き",
      "submitTo": "市区町村役場の住民票の窓口",
      "evidenceRequired": false,
      "assetDisposal": false,
      "requiredDocuments": [
        {
          "id": "applicant-identification",
          "label": "届出人の本人確認書類"
        }
      ],
      "deadlineRuleId": "household-change-notification",
      "applicability": {
        "default": "maybe",
        "rules": []
      },
      "variants": [],
      "targetDate": null
    },
    {
      "id": "health-insurance-loss",
      "title": "健康保険の資格喪失の手続きをする",
      "summary": "保険証（または資格確認書）を返します。加入していた保険によって窓口が違います（国民健康保険・後期高齢者医療は市区町村、会社の健康保険は勤務先）。",
      "stage": "government",
      "category": "年金・保険",
      "submitTo": "市区町村役場の保険年金の窓口",
      "evidenceRequired": false,
      "assetDisposal": false,
      "requiredDocuments": [
        {
          "id": "health-insurance-card",
          "label": "故人の保険証または資格確認書"
        }
      ],
      "deadlineRuleId": "national-health-insurance-loss",
      "applicability": {
        "default": "yes",
        "rules": []
      },
      "variants": [
        {
          "when": {
            "any": [
              {
                "field": "healthInsurance",
                "in": [
                  "LATE_ELDERLY"
                ]
              },
              {
                "ageAtDeath": {
                  "gte": 75
                }
              }
            ]
          },
          "title": "後期高齢者医療の資格喪失届を出す",
          "deadlineRuleId": "late-elderly-medical-loss"
        },
        {
          "when": {
            "field": "healthInsurance",
            "in": [
              "NATIONAL"
            ]
          },
          "title": "国民健康保険の資格喪失届を出す"
        },
        {
          "when": {
            "field": "healthInsurance",
            "in": [
              "EMPLOYEE"
            ]
          },
          "title": "勤務先に連絡し、健康保険証を返す",
          "summary": "会社の健康保険は、勤務先が手続きをします。勤務先に亡くなったことを伝え、保険証（または資格確認書）を返してください。",
