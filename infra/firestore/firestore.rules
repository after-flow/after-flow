rules_version = '2';

// 業務 Firestore はクライアントから直接アクセスさせない。
// Web の業務通信は Backend の公開 API のみを経由する（仕様書 15.4）。
//
// 重要: Server SDK は Security Rules を迂回する。したがってこのファイルは
// 「クライアント SDK からの直接アクセスを閉じる」ためのものであり、
// Application 層の認可（#6）の代わりにはならない。両方が必要。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
