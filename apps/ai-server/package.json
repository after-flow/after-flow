{
  "name": "@aftercare/ai-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node ../../scripts/test-workspace.mjs && node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@mastra/core": "1.67.0",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.2"
  }
}
