{
  "name": "@aftercare/backend-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "openapi:generate": "tsx src/tools/generate-openapi.ts",
    "openapi:check": "tsx src/tools/generate-openapi.ts --check"
  },
  "dependencies": {
    "@aftercare/public-contracts": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.2",
    "yaml": "2.8.1"
  }
}
