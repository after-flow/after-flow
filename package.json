{
  "name": "after-flow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "10.28.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @aftercare/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "lint": "oxlint apps packages scripts && pnpm check:boundaries",
    "check:boundaries": "node scripts/verify-boundaries.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
