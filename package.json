{
  "name": "after-flow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "10.28.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @aftercare/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @aftercare/internal-contracts build && pnpm -r typecheck",
    "lint": "oxlint apps packages scripts && pnpm check:boundaries",
    "check:boundaries": "node scripts/verify-boundaries.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "openapi:check": "pnpm --filter @aftercare/backend-server openapi:check",
    "openapi:generate": "pnpm --filter @aftercare/backend-server openapi:generate",
    "test:firestore": "pnpm --filter @aftercare/backend-server test:firestore && pnpm --filter @aftercare/ai-server test:firestore",
    "eval:ai": "pnpm --filter @aftercare/ai-server eval:fixture",
    "eval:ai:live": "pnpm --filter @aftercare/ai-server eval:live-guidance",
    "eval:ai:skill-loading": "pnpm --filter @aftercare/ai-server eval:compare-skill-loading",
    "smoke:orca": "pnpm --filter @aftercare/ai-server smoke:orca"
  },
  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "yaml": "2.8.3"
  }
}
