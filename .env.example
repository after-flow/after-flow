# Optional overrides. Copy to .env at the repository root if needed.
# Empty values use defaults; never put server credentials in VITE_* variables.

# Docker host ports. AI is not published to the host.
WEB_PORT=
BACKEND_PORT=
FIRESTORE_EMULATOR_PORT=
STORAGE_EMULATOR_PORT=
# 9099が使用中の場合だけ変える。ブラウザーは127.0.0.1で直接この番号へ到達するため、
# 変える場合はVITE_FIREBASE_AUTH_EMULATOR_URLも合わせて変える。
AUTH_EMULATOR_PORT=

# ローカルのSwagger UI。開発では既定で有効、本番では既定で無効。
API_DOCS_ENABLED=

# Development defaults to mocks; production builds default to no mocks.
# Set true explicitly only for a mock demonstration production build.
VITE_USE_MOCK=
VITE_API_BASE_URL=

# Local Vite backend proxy. Compose uses http://backend-server:8080.
# For local real-API development: http://127.0.0.1:8080
VITE_API_PROXY=
VITE_WATCH_POLLING=

# Firebase Authentication（本番はFirebase Client SDKの設定値。ローカルはAuth Emulator）。
# ローカル既定はdemo-api-key / demo-after-flow / http://127.0.0.1:9099（make upが設定する）。
# VITE_FIREBASE_AUTH_DOMAINは本番のみ設定する。VITE_USE_MOCK=falseかつ
# VITE_FIREBASE_API_KEY未設定のまま起動すると、FEは起動を止めて理由を表示する
# （fail-closed）。本番ビルドでVITE_FIREBASE_AUTH_EMULATOR_URLが設定されていても止める。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_AUTH_EMULATOR_URL=

# 業務Firestore。Backendにだけ渡す設定で、AI Serverには渡さない。
# make up が firestore-emulator:8085 を設定する。
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECT_ID=

# 認証。本番はFirebase Authentication（docs/adr/0001-authentication-provider.md）。
# 未設定のまま起動した場合、認証が必要なAPIはすべて401になる。無効化ではなく全拒否。
# ローカルの既定はAUTH_MODE=firebase-emulator（make upだけで動く）。
# Swagger UIをstatic-jwksで試す代替手順はdocs/runbooks/local-swagger.mdを参照
# （`make dev-auth`がAUTH_MODE=static-jwksとAUTH_STATIC_JWKSをこのファイルへ追記する。
# 秘密鍵は.dev-auth/に置く（gitignore済み）。compose既定のfirebase-emulatorを上書きするため、
# FEの実ログインは通らなくなる）。static-jwks・firebase-emulatorは本番では起動を拒否する。
AUTH_MODE=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URI=
AUTH_STATIC_JWKS=
# 既定はRS256,ES256。対称鍵とnoneは指定できない。
AUTH_ALGORITHMS=
# 配備単位で固定するtenant。全モード必須。OUTBOX_TENANT_IDSと既定を一致させ、
# 変える場合は両方変える（一致していないとWorkerが対象tenantのOutboxを処理しない）。
AUTH_TENANT_ID=
# 既定true。falseはAUTH_MODE=firebase-emulator限定（jwksでfalseは起動を拒否する）。
AUTH_REQUIRE_EMAIL_VERIFIED=
# AUTH_MODE=firebase-emulatorのときの接続先。検証には使わない（設定の意図を明示させる）。
# make upの既定はfirebase-auth-emulator:9099。
FIREBASE_AUTH_EMULATOR_HOST=

# 同意文書のカタログ。未設定なら開発用の仮文面を使う。
# 本番では承認済みの文書を指すこと。仮文面のままでは起動できない。
CONSENT_CATALOG_PATH=

# Backendだけに設定。両方未設定なら書類APIは未接続。両方指定すると起動を拒否する。
# 開発・CI用のローカル保存。
DOCUMENT_STORAGE_ROOT=
# Cloud Storageの非公開bucket。認証はBackend専用ADC/IAMを使用。AIへ設定・資格情報を渡さない。
DOCUMENT_STORAGE_BUCKET=
# make up がBackendにだけ設定するローカルEmulator endpoint。
# SDKが暗黙に読むSTORAGE_EMULATOR_HOSTは使わない。
DOCUMENT_STORAGE_EMULATOR_ENDPOINT=
STORAGE_PROJECT_ID=

# 期限ルールと初期手続きの定義。未設定なら業務レビュー未了の仮定義を使う。
# 仮定義から確定した期限は算定されず、「要確認」として返る。
DEADLINE_RULES_PATH=

# AI Serverへの配送。未設定なら配送しない（イベントはPENDINGのまま残る）。
AI_SERVER_URL=
AI_SERVICE_TOKEN=
AI_SERVICE_AUDIENCE=
AI_SERVICE_TIMEOUT_MS=
# 受け付ける業務操作をカンマ区切りで指定する。未設定ならどれも未接続。
# ローカルE2Eで有効にするのは task_guidance だけ。Composeの既定は空のまま。
AI_CONNECTED_OPERATIONS=

# AIからBackendへの内部API。未設定なら内部APIを公開しない。
BACKEND_SERVICE_AUDIENCE=
# Backend→AIのAI_SERVICE_TOKENとは必ず別のサービス資格情報。
BACKEND_INTERNAL_SERVICE_TOKEN=
# 32 bytes以上の署名鍵。Backend/workerだけに配置し、AIへは絶対に渡さない。
BACKEND_EXECUTION_SIGNING_KEY=

# Backend専用の独立Outbox worker。対象tenantを明示する。AIへは渡さない。
# make up は backend-worker container を after-flow-demo の1 tenantで起動する。
OUTBOX_TENANT_IDS=
OUTBOX_INTERVAL_MS=5000
OUTBOX_VISIBILITY_MS=120000

# AI専用OrcaRouterキー。pnpm smoke:orca はこのキーだけを読み込む。
# Compose/既定mainの業務Run接続は別途設定する。apps/ai-server/ORCAROUTER.md を参照。
ORCAROUTER_API_KEY=

# ハッカソン用AI Runtime。autoはAPIキーがある開発環境だけ実行機能を接続する。
# productionではhackathon compositionを起動できない。
AI_RUNTIME_MODE=auto
AI_ORCA_CORE_MODEL=openai/gpt-4o-mini
AI_ORCA_FALLBACK_MODEL=google/gemini-2.5-flash
# Docker外で起動するときだけ設定。ComposeはAI専用Emulatorの値を設定する。
AI_RUNTIME_PROJECT_ID=
AI_RUNTIME_DATABASE_ID=
AI_RUNTIME_EMULATOR_HOST=
# 32 byteをbase64化したAI専用鍵。Backend署名鍵と共有しない。
AI_RUNTIME_ENCRYPTION_KEY=
BACKEND_INTERNAL_URL=

# 内部readiness endpoint（GET /internal/v1/health/ready）。運用/デプロイツール専用。
# 未設定ならこのendpointをmountしない。AI_SERVICE_TOKEN/BACKEND_INTERNAL_SERVICE_TOKENとは
# 必ず別の値にする（AIやブラウザーへは絶対に渡さない）。詳細はdocs/runbooks/readiness.md。
READINESS_ACCESS_TOKEN=
