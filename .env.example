# Optional overrides. Copy to .env at the repository root if needed.
# Empty values use defaults; never put server credentials in VITE_* variables.

# Docker host ports (web: 5173, backend: 8080). AI is not published to the host.
WEB_PORT=
BACKEND_PORT=

# Development defaults to mocks; production builds default to no mocks.
# Set true explicitly only for a mock demonstration production build.
VITE_USE_MOCK=
VITE_API_BASE_URL=

# Local Vite backend proxy. Compose uses http://backend-server:8080.
# For local real-API development: http://127.0.0.1:8080
VITE_API_PROXY=
VITE_WATCH_POLLING=

# 業務Firestore。Backendにだけ渡す設定で、AI Serverには渡さない。
# Emulatorを使う場合は make up-data が firestore-emulator:8085 を設定する。
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECT_ID=
