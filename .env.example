# Optional overrides. Copy to .env at the repository root if needed.
# Empty values use defaults; never put server credentials in VITE_* variables.

# Docker host ports (web: 5173, backend: 8080). AI is not published to the host.
WEB_PORT=
BACKEND_PORT=

# Development defaults to mocks; production builds default to no mocks.
# Set true explicitly only for a mock demonstration production build.
VITE_USE_MOCK=
VITE_API_BASE_URL=

# Local Vite backend proxy. Compose uses http://backend-server:8080.
# For local real-API development: http://127.0.0.1:8080
VITE_API_PROXY=
VITE_WATCH_POLLING=

# 業務Firestore。Backendにだけ渡す設定で、AI Serverには渡さない。
# Emulatorを使う場合は make up-data が firestore-emulator:8085 を設定する。
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECT_ID=

# 認証。採用Providerは未確定（docs/adr/0001-authentication-provider.md）。
# 未設定のまま起動した場合、認証が必要なAPIはすべて401になる。無効化ではなく全拒否。
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URI=
# 既定はRS256,ES256。対称鍵とnoneは指定できない。
AUTH_ALGORITHMS=
AUTH_TENANT_CLAIM=

# 同意文書のカタログ。未設定なら開発用の仮文面を使う。
# 本番では承認済みの文書を指すこと。仮文面のままでは起動できない。
CONSENT_CATALOG_PATH=

# 原本の保存先（開発・CI用のローカル保存）。未設定なら書類APIは未接続として拒否する。
# 本番のCloud Storage Adapterは別途実装する。
DOCUMENT_STORAGE_ROOT=

# 期限ルールと初期手続きの定義。未設定なら業務レビュー未了の仮定義を使う。
# 仮定義から確定した期限は算定されず、「要確認」として返る。
DEADLINE_RULES_PATH=

# AI Serverへの配送。未設定なら配送しない（イベントはPENDINGのまま残る）。
AI_SERVER_URL=
AI_SERVICE_TOKEN=
AI_SERVICE_AUDIENCE=
AI_SERVICE_TIMEOUT_MS=
# 受け付ける業務操作をカンマ区切りで指定する。未設定ならどれも未接続。
AI_CONNECTED_OPERATIONS=

# AIからBackendへの内部API。未設定なら内部APIを公開しない。
BACKEND_SERVICE_AUDIENCE=
# Backend→AIのAI_SERVICE_TOKENとは必ず別のサービス資格情報。
BACKEND_INTERNAL_SERVICE_TOKEN=
# 32 bytes以上の署名鍵。Backend/workerだけに配置し、AIへは絶対に渡さない。
BACKEND_EXECUTION_SIGNING_KEY=

# Backend専用の独立Outbox worker。対象tenantを明示する。AIへは渡さない。
OUTBOX_TENANT_IDS=
OUTBOX_INTERVAL_MS=5000
OUTBOX_VISIBILITY_MS=120000
